{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/submit.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/partial-lead.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/pricing-config.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
